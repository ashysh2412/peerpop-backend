{
  "name": "video-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A CLI agent that turns a one-line brief into a finished short video: shot list, AI-generated clips, captions, voiceover, music.",
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "@google/genai": "^3.6.1",
    "@runwayml/sdk": "^4.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
