# Claude, for the agent itself (required unless you use Bedrock/Vertex/Foundry env vars).
ANTHROPIC_API_KEY=sk-ant-...

# Footage provider: mock | runway | veo   (mock needs no key: it renders test-pattern clips with ffmpeg)
VIDEO_PROVIDER=mock

# Runway (https://dev.runwayml.com). One key covers video (Veo 3.1, Gen-4.5, Kling, Hailuo...),
# voiceover (ElevenLabs voices) and music.
RUNWAYML_API_SECRET=
RUNWAY_VIDEO_MODEL=veo3.1_fast
RUNWAY_VOICE=Arjun

# Google Veo straight from the Gemini API (https://aistudio.google.com/apikey).
# Google rotates Veo model IDs often; check https://ai.google.dev/gemini-api/docs/video for the current one.
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-fast-generate-preview

# Guard rails. Clips cost real money (Veo 3.1 Fast is roughly $0.10-0.15 per second of footage).
MAX_CLIPS=10
MAX_CLIP_SECONDS=80
