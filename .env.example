# Supabase project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only secrets (never prefix with NEXT_PUBLIC_)
# Supabase project > Settings > API Keys > Secret keys
SUPABASE_SECRET_KEY=sb_secret_...
# Google Cloud > APIs & Services > Credentials (YouTube Data API v3)
YOUTUBE_API_KEY=AIza...
# Any long random string; Vercel Cron sends it to /api/cron/refresh-youtube
CRON_SECRET=

# Resend API key for notification emails (requests). Without it, no emails are sent.
RESEND_API_KEY=
